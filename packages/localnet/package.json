{
  "name": "@joe-p/algosdk-localnet",
  "version": "0.3.0",
  "description": "LocalNet helpers for algosdk-future",
  "repository": {
    "type": "git",
    "url": "https://github.com/joe-p/algosdk-future-ts",
    "directory": "packages/localnet"
  },
  "module": "dist/index.js",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\" && tsc6 -p tsconfig.build.json",
    "prepack": "pnpm run build"
  },
  "peerDependencies": {
    "algosdk": "^3.8.0"
  },
  "dependencies": {
    "@joe-p/algosdk-composer": "workspace:^",
    "algosdk": "^3.8.0",
    "tweetnacl": "^1.0.3"
  }
}
