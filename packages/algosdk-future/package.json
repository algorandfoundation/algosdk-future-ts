{
  "name": "@algosdk/future",
  "version": "0.13.0",
  "description": "Re-exports every @algosdk/future package",
  "repository": {
    "type": "git",
    "url": "https://github.com/joe-p/algosdk-future-ts",
    "directory": "packages/algosdk-future"
  },
  "module": "dist/index.js",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\" && tsc6 -p tsconfig.build.json",
    "prepack": "pnpm run build"
  },
  "peerDependencies": {
    "algosdk": "^3.8.0"
  },
  "dependencies": {
    "@algosdk/app-client": "workspace:^",
    "@algosdk/transaction-composer": "workspace:^",
    "@algosdk/typed-client-generator": "workspace:^",
    "@algosdk/localnet": "workspace:^",
    "algosdk": "^3.8.0"
  }
}
