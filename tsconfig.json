{
  "exclude": ["node_modules", "fixtures/contracts"],
  "compilerOptions": {
    // Environment setup & latest features
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "allowJs": true,
    "types": ["node"],

    // Bundler mode
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    // Resolve workspace packages to their sources, so tests and type checks
    // don't need the packages to be built
    "paths": {
      "@algosdk/future": ["./packages/algosdk-future/src/index.ts"],
      "@algosdk/transaction-composer": ["./packages/composer/src/index.ts"],
      "@algosdk/app-client": ["./packages/app-client/src/index.ts"],
      "@algosdk/localnet": ["./packages/localnet/src/index.ts"],
      "@algosdk/typed-client-generator": ["./packages/generator/src/index.ts"]
    },

    // Best practices
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,

    // Some stricter flags (disabled by default)
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false
  }
}
